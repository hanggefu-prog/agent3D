{
  "schema": "engineering-evaluation-profile-v2",
  "task": "multi_hbt_fanout",
  "scoring_version": 2,
  "identity_version": 2,
  "capability_schema": 2,
  "allow_unverified_capabilities": [],
  "calibration": {
    "qor_noop": "qualified reference metric (the unmodified input measured by the same native endpoint)",
    "normalized_formula": "100*(qor-qor_noop)/(qor_expert-qor_noop)",
    "failed_case_score": 0.0,
    "expert_registry": "expert-reference.json"
  },
  "judge": {
    "weight_in_headline": 0,
    "min_samples": 3,
    "aggregation": "median"
  },
  "gates": {
    "receiver_scope": "all",
    "added_buffer_area": {
      "max_ratio_to_min_buffer_area_per_target": 4.0,
      "basis": "sum over target nets of the smallest provided buffer area on the target source die"
    }
  }
}
