+
+# Some maintained OpenROAD binaries predate the analysis-only detailed-RC
+# cutpoint command.  Keep the continuous passive-HBT graph authoritative and
+# derive a conservative die-boundary budget from its real driver/load timing
+# properties in that case.  The driver envelope supplies the source required
+# time; the latest downstream load supplies the sink arrival and slew.  This
+# changes only the inter-die budget projection--global WNS/TNS above and after
+# each die pass still come from the complete stitched passive network.
+proc open3d_finite_ui_value {value} {
+  return [expr {
+    [string is double -strict $value]
+    && abs(double($value)) < 1.0e20
+  }]
+}
+
+proc open3d_pin_ui_value {pin property} {
+  if {[catch {set value [get_property $pin $property]}]} { return "" }
+  if {![open3d_finite_ui_value $value]} { return "" }
+  return [expr {double($value)}]
+}
+
+proc open3d_endpoint_envelope_timing {point transition driver} {
+  set net [get_nets -quiet -of_objects $driver]
+  if {[llength $net] != 1} { return [dict create] }
+  set loads [sta::net_load_pins $net]
+  set selected $driver
+  if {$point eq "far"} {
+    set latest ""
+    foreach load $loads {
+      set value [open3d_pin_ui_value $load "arrival_max_${transition}"]
+      if {$value ne "" && ($latest eq "" || $value > $latest)} {
+        set latest $value
+        set selected $load
+      }
+    }
+    if {$latest eq ""} { return [dict create] }
+  }
+
+  set arrival_ui [open3d_pin_ui_value $selected "arrival_max_${transition}"]
+  if {$arrival_ui eq ""} { return [dict create] }
+  set slew_ui [open3d_pin_ui_value $selected "slew_max_${transition}"]
+  if {$slew_ui eq "" || $slew_ui <= 0.0} { set slew_ui 0.0 }
+  set slack_ui [open3d_pin_ui_value $selected "slack_max_${transition}"]
+  set constrained [expr {$slack_ui ne ""}]
+  set required_ui [expr {
+    $constrained ? $arrival_ui + $slack_ui : 0.0
+  }]
+  set driver_arrival_ui [open3d_pin_ui_value \
+    $driver "arrival_max_${transition}"]
+  set wire_delay_ui 0.0
+  if {$driver_arrival_ui ne "" && $arrival_ui > $driver_arrival_ui} {
+    set wire_delay_ui [expr {$arrival_ui - $driver_arrival_ui}]
+  }
+  set load_count [llength $loads]
+  set pi [sta::find_pi_elmore $driver $transition max]
+  set downstream_cap 0.0
+  if {[llength $pi] == 3} {
+    set downstream_cap [expr {[lindex $pi 0] + [lindex $pi 2]}]
+  }
+  return [dict create \
+    arrival [sta::time_ui_sta $arrival_ui] \
+    slew [sta::time_ui_sta $slew_ui] \
+    required [sta::time_ui_sta $required_ui] \
+    slack [sta::time_ui_sta [expr {$constrained ? $slack_ui : 0.0}]] \
+    wire_delay [sta::time_ui_sta $wire_delay_ui] \
+    elmore [sta::time_ui_sta $wire_delay_ui] \
+    downstream_cap $downstream_cap \
+    path_resistance 0.0 \
+    downstream_load_count $load_count \
+    constrained_load_count [expr {$constrained ? $load_count : 0}] \
+    constrained $constrained]
+}
